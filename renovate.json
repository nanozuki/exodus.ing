{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", "security:minimumReleaseAgeNpm", "group:all"],
  "enabledManagers": ["npm", "nix", "github-actions", "custom.regex"],
  "nix": { "enabled": true },
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "prCreation": "immediate",
  "draftPR": false,
  "prConcurrentLimit": 3,
  "rebaseWhen": "behind-base-branch",
  "rangeStrategy": "pin",
  "semanticCommitType": "chore",
  "prFooter": "",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* * * * 1"]
  },
  "timezone": "Europe/Berlin",
  "packageRules": [
    {
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "matchManagers": ["nix"],
      "postUpgradeTasks": {
        "commands": ["nix develop --command node src/scripts/sync-node-version.ts --write"],
        "fileFilters": ["Dockerfile"],
        "executionMode": "branch"
      }
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/dependencies\\.yml$/"],
      "matchStrings": ["RENOVATE_VERSION: '(?<currentValue>[^']+)'"],
      "depNameTemplate": "renovate",
      "datasourceTemplate": "npm"
    }
  ]
}
