{
  "name": "exodus.ing",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nanozuki/exodus.ing.git"
  },
  "scripts": {
    "dev": "tsx src/scripts/pg.ts start dev && PGDATABASE=exodus-dev vite dev",
    "build": "vite build",
    "preview": "APP_URL=http://localhost:4173 vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:e2e": "svelte-kit sync && tsc --project e2e/tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check --write . && eslint .",
    "test": "pnpm test:unit --run && pnpm test:script && pnpm test:e2e",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "test:script": "tsx --test src/scripts/*.integration.ts e2e/support/*.integration.ts",
    "pg:status": "tsx src/scripts/pg.ts status",
    "pg:stop": "tsx src/scripts/pg.ts stop",
    "pg:reset": "tsx src/scripts/pg.ts reset",
    "db:export": "drizzle-kit export > src/lib/server/db/database.sql",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@flydotio/dockerfile": "0.7.13",
    "@iconify-json/material-symbols-light": "1.2.97",
    "@iconify-json/mdi": "^1.2.3",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/eslint": "^9.6.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@vitest/browser-playwright": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "melt": "^0.44.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "tsx": "4.23.15",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.1",
    "unplugin-icons": "^24.0.0",
    "vfile": "^6.0.3",
    "vite": "^8.0.12",
    "vitest": "^5.0.5",
    "vitest-browser-svelte": "^3.1.0",
    "zod": "^4.6.7"
  },
  "type": "module",
  "dependencies": {
    "arctic": "^3.7.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "modern-normalize": "^3.0.1",
    "nanoid": "^6.0.2",
    "pg": "^8.23.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "runed": "^0.37.1",
    "tailwind-merge": "^3.7.0",
    "unified": "^11.0.5",
    "vfile-matter": "^5.0.1"
  },
  "packageManager": "pnpm@12.15.0",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
