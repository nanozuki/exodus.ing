{
  "singleQuote": true,
  "printWidth": 120,
  "plugins": ["prettier-plugin-svelte", "prettier-plugin-tailwindcss"],
  "overrides": [
    { "files": "*.svelte", "options": { "parser": "svelte" } },
    { "files": ["*.md", "*.mdx", "*.markdown"], "options": { "printWidth": 80, "proseWrap": "always" } }
  ]
}
